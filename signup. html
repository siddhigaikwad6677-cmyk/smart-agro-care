<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Sign Up | Smart Agro Care</title>

    <link rel="stylesheet"
          href="style.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


    <style>

        /* =========================================
           SIGNUP PAGE
           ========================================= */

        body {
            min-height: 100vh;

            background:
                linear-gradient(
                    135deg,
                    #e5f7e8,
                    #f9fcf9
                );

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 30px 0;

            overflow-x: hidden;

            position: relative;
        }


        body::before {

            content: "🌿";

            position: fixed;

            font-size: 180px;

            left: -45px;

            top: -40px;

            opacity: .08;

            animation:
                floating 6s ease-in-out infinite;

        }


        body::after {

            content: "🌾";

            position: fixed;

            font-size: 180px;

            right: -45px;

            bottom: -60px;

            opacity: .08;

            animation:
                floating 7s ease-in-out infinite reverse;

        }


        /* =========================================
           CONTAINER
           ========================================= */

        .signup-wrapper {

            width: min(1000px, 92%);

            min-height: 600px;

            display: grid;

            grid-template-columns:
                1fr 1.15fr;

            background: white;

            border-radius: 30px;

            overflow: hidden;

            box-shadow:
                0 30px 80px
                rgba(30,90,45,.15);

            position: relative;

            z-index: 2;

            animation:
                signupAppear .8s ease;

        }


        @keyframes signupAppear {

            from {

                opacity: 0;

                transform:
                    translateY(30px)
                    scale(.97);

            }

            to {

                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);

            }

        }


        /* =========================================
           LEFT PANEL
           ========================================= */

        .signup-info {

            padding: 55px;

            color: white;

            background:
                linear-gradient(
                    145deg,
                    #103d25,
                    #238149
                );

            display: flex;

            flex-direction: column;

            justify-content: center;

            position: relative;

            overflow: hidden;

        }


        .signup-info::before {

            content: "";

            width: 280px;

            height: 280px;

            border-radius: 50%;

            background:
                rgba(255,255,255,.06);

            position: absolute;

            right: -120px;

            top: -90px;

        }


        .signup-info::after {

            content: "";

            width: 230px;

            height: 230px;

            border-radius: 50%;

            background:
                rgba(145,220,100,.08);

            position: absolute;

            left: -100px;

            bottom: -80px;

        }


        .signup-logo {

            width: 55px;

            height: 55px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                rgba(255,255,255,.14);

            border-radius: 16px;

            font-size: 24px;

            margin-bottom: 22px;

        }


        .signup-info h1 {

            font-family:
                Georgia,
                serif;

            font-size:
                clamp(35px,4vw,50px);

            line-height: 1.1;

        }


        .signup-info h1 span {

            color: #a9e77e;

            font-style: italic;

        }


        .signup-info p {

            margin-top: 18px;

            max-width: 400px;

            color: #d7edda;

            font-size: 10px;

            line-height: 1.9;

        }


        /* Benefits */

        .benefits {

            margin-top: 30px;

            display: flex;

            flex-direction: column;

            gap: 12px;

        }


        .benefit {

            display: flex;

            align-items: center;

            gap: 10px;

            color: #e2f3e5;

            font-size: 9px;

        }


        .benefit i {

            width: 27px;

            height: 27px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            color: #b8eb8e;

            background:
                rgba(255,255,255,.1);

        }


        /* =========================================
           RIGHT PANEL
           ========================================= */

        .signup-form-area {

            padding:
                45px 60px;

            display: flex;

            flex-direction: column;

            justify-content: center;

        }


        .signup-form-area h2 {

            color: #153d27;

            font-family:
                Georgia,
                serif;

            font-size: 32px;

        }


        .signup-subtitle {

            margin-top: 7px;

            color: #7a887f;

            font-size: 9px;

        }


        /* =========================================
           FORM
           ========================================= */

        .signup-form {

            margin-top: 25px;

        }


        .signup-input {

            margin-bottom: 13px;

        }


        .signup-input label {

            display: block;

            margin-bottom: 6px;

            color: #41564a;

            font-size: 8px;

            font-weight: 800;

        }


        .input-box {

            position: relative;

        }


        .input-box > i {

            position: absolute;

            left: 13px;

            top: 50%;

            transform:
                translateY(-50%);

            color: #55a968;

            font-size: 11px;

        }


        .input-box input,
        .input-box select {

            width: 100%;

            height: 43px;

            padding:
                0 40px;

            border:
                1px solid #dfe9e1;

            border-radius: 10px;

            outline: none;

            background: #fbfdfb;

            color: #294b35;

            font-size: 9px;

            transition: .25s;

        }


        .input-box select {

            padding-left: 40px;

            cursor: pointer;

        }


        .input-box input:focus,
        .input-box select:focus {

            background: white;

            border-color: #55ad6b;

            box-shadow:
                0 0 0 4px
                rgba(80,170,100,.08);

        }


        /* =========================================
           PASSWORD STRENGTH
           ========================================= */

        .password-strength {

            height: 4px;

            margin-top: 7px;

            border-radius: 20px;

            background: #e7eee9;

            overflow: hidden;

        }


        .strength-bar {

            width: 0%;

            height: 100%;

            border-radius: 20px;

            transition: .3s;

            background: #2e9b52;

        }


        .strength-text {

            display: block;

            margin-top: 5px;

            color: #89948d;

            font-size: 7px;

        }


        /* =========================================
           TERMS
           ========================================= */

        .terms {

            display: flex;

            align-items: flex-start;

            gap: 7px;

            margin-top: 12px;

            color: #77837c;

            font-size: 7px;

            line-height: 1.5;

        }


        .terms input {

            margin-top: 2px;

            accent-color: #238149;

        }


        .terms a {

            color: #238149;

            font-weight: 700;

        }


        /* =========================================
           CREATE ACCOUNT BUTTON
           ========================================= */

        .create-btn {

            width: 100%;

            height: 45px;

            margin-top: 18px;

            border: none;

            border-radius: 11px;

            color: white;

            background:
                linear-gradient(
                    135deg,
                    #176b3a,
                    #42ad60
                );

            cursor: pointer;

            font-size: 9px;

            font-weight: 800;

            box-shadow:
                0 10px 25px
                rgba(23,107,58,.18);

            transition: .3s;

        }


        .create-btn:hover {

            transform:
                translateY(-3px);

            box-shadow:
                0 15px 30px
                rgba(23,107,58,.25);

        }


        /* =========================================
           LOGIN LINK
           ========================================= */

        .already {

            text-align: center;

            margin-top: 17px;

            color: #7b877f;

            font-size: 8px;

        }


        .already a {

            color: #218048;

            font-weight: 800;

        }


        /* =========================================
           LANGUAGE
           ========================================= */

        .language {

            position: fixed;

            top: 20px;

            right: 25px;

            z-index: 10;

        }


        .language select {

            padding: 7px 10px;

            border:
                1px solid #dce7df;

            border-radius: 8px;

            background: white;

            color: #356045;

            outline: none;

            font-size: 8px;

        }


        /* =========================================
           MOBILE
           ========================================= */

        @media(max-width: 750px) {

            body {

                padding: 25px 0;

            }


            .signup-wrapper {

                grid-template-columns: 1fr;

                width: 94%;

            }


            .signup-info {

                padding: 40px 30px;

                min-height: 330px;

            }


            .signup-form-area {

                padding:
                    40px 30px;

            }

        }


        @media(max-width: 450px) {

            .signup-info {

                padding:
                    35px 22px;

            }


            .signup-form-area {

                padding:
                    35px 22px;

            }

        }

    </style>

</head>


<body>


    <!-- =========================================
         LANGUAGE
         ========================================= -->

    <div class="language">

        <select
            onchange="switchLanguage(this.value)">

            <option value="en">
                English
            </option>

            <option value="mr">
                मराठी
            </option>

        </select>

    </div>


    <!-- =========================================
         MAIN
         ========================================= -->

    <main class="signup-wrapper">


        <!-- =====================================
             INFORMATION
             ===================================== -->

        <section class="signup-info">


            <div class="signup-logo">

                🌱

            </div>


            <h1>

                Grow with

                <span>
                    Smart Farming
                </span>

            </h1>


            <p>

                Create your Smart Agro Care
                account and explore smart
                tools designed to make farming
                easier and more informed.

            </p>


            <div class="benefits">


                <div class="benefit">

                    <i class="fa-solid fa-seedling"></i>

                    <span>
                        Smart Soil Analysis
                    </span>

                </div>


                <div class="benefit">

                    <i class="fa-solid fa-microscope"></i>

                    <span>
                        Crop Disease Detection
                    </span>

                </div>


                <div class="benefit">

                    <i class="fa-solid fa-chart-line"></i>

                    <span>
                        Soil Health Reports
                    </span>

                </div>


                <div class="benefit">

                    <i class="fa-solid fa-robot"></i>

                    <span>
                        Farming AI Assistant
                    </span>

                </div>


            </div>

        </section>



        <!-- =====================================
             FORM
             ===================================== -->

        <section class="signup-form-area">


            <h2>

                Create Account

            </h2>


            <p class="signup-subtitle">

                Join Smart Agro Care today 🌱

            </p>


            <form
                class="signup-form"
                onsubmit="createAccount(event)">


                <!-- NAME -->

                <div class="signup-input">

                    <label>
                        Full Name
                    </label>

                    <div class="input-box">

                        <i class="fa-solid fa-user"></i>

                        <input
                            type="text"
                            id="signupName"
                            placeholder="Enter your name"
                            required>

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="signup-input">

                    <label>
                        Email Address
                    </label>

                    <div class="input-box">

                        <i class="fa-solid fa-envelope"></i>

                        <input
                            type="email"
                            id="signupEmail"
                            placeholder="Enter your email"
                            required>

                    </div>

                </div>


                <!-- ROLE -->

                <div class="signup-input">

                    <label>
                        I am a
                    </label>

                    <div class="input-box">

                        <i class="fa-solid fa-users"></i>

                        <select
                            id="userRole"
                            required>

                            <option value="">
                                Select your role
                            </option>

                            <option value="farmer">
                                Farmer
                            </option>

                            <option value="student">
                                Student
                            </option>

                            <option value="researcher">
                                Researcher
                            </option>

                            <option value="other">
                                Other
                            </option>

                        </select>

                    </div>

                </div>


                <!-- PASSWORD -->

                <div class="signup-input">

                    <label>
                        Password
                    </label>

                    <div class="input-box">

                        <i class="fa-solid fa-lock"></i>

                        <input
                            type="password"
                            id="signupPassword"
                            placeholder="Create a password"
                            required
                            oninput="checkPasswordStrength()">

                    </div>


                    <div class="password-strength">

                        <div
                            id="strengthBar"
                            class="strength-bar">
                        </div>

                    </div>


                    <span
                        id="strengthText"
                        class="strength-text">

                        Use at least 8 characters.

                    </span>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="signup-input">

                    <label>
                        Confirm Password
                    </label>

                    <div class="input-box">

                        <i class="fa-solid fa-shield-halved"></i>

                        <input
                            type="password"
                            id="confirmPassword"
                            placeholder="Confirm your password"
                            required>

                    </div>

                </div>


                <!-- TERMS -->

                <label class="terms">

                    <input
                        type="checkbox"
                        id="terms"
                        required>

                    <span>

                        I agree to the
                        <a href="#">
                            Terms
                        </a>
                        and
                        <a href="#">
                            Privacy Policy
                        </a>.

                    </span>

                </label>


                <!-- BUTTON -->

                <button
                    type="submit"
                    class="create-btn">

                    Create My Account

                    <i
                        class="fa-solid fa-arrow-right">
                    </i>

                </button>


            </form>


            <p class="already">

                Already have an account?

                <a href="login.html">

                    Login

                </a>

            </p>


        </section>

    </main>



    <!-- =========================================
         JAVASCRIPT
         ========================================= -->

    <script src="script.js"></script>


    <script>


        /* =====================================
           PASSWORD STRENGTH
           ===================================== */

        function checkPasswordStrength() {

            const password =
                document.getElementById(
                    "signupPassword"
                ).value;


            const bar =
                document.getElementById(
                    "strengthBar"
                );


            const text =
                document.getElementById(
                    "strengthText"
                );


            let strength = 0;


            if (password.length >= 8) {

                strength++;

            }


            if (
                /[A-Z]/.test(password)
            ) {

                strength++;

            }


            if (
                /[0-9]/.test(password)
            ) {

                strength++;

            }


            if (
                /[^A-Za-z0-9]/.test(password)
            ) {

                strength++;

            }


            if (strength === 0) {

                bar.style.width = "0%";

                text.textContent =
                    "Use at least 8 characters.";

            }

            else if (strength === 1) {

                bar.style.width = "25%";

                text.textContent =
                    "Weak password";

            }

            else if (strength === 2) {

                bar.style.width = "50%";

                text.textContent =
                    "Medium password";

            }

            else if (strength === 3) {

                bar.style.width = "75%";

                text.textContent =
                    "Good password";

            }

            else {

                bar.style.width = "100%";

                text.textContent =
                    "Strong password ✓";

            }

        }



        /* =====================================
           CREATE ACCOUNT
           ===================================== */

        function createAccount(event) {

            event.preventDefault();


            const name =
                document.getElementById(
                    "signupName"
                ).value.trim();


            const email =
                document.getElementById(
                    "signupEmail"
                ).value.trim();


            const role =
                document.getElementById(
                    "userRole"
                ).value;


            const password =
                document.getElementById(
                    "signupPassword"
                ).value;


            const confirm =
                document.getElementById(
                    "confirmPassword"
                ).value;


            const terms =
                document.getElementById(
                    "terms"
                ).checked;


            /* Password check */

            if (password.length < 8) {

                showNotification(
                    "Password must contain at least 8 characters.",
                    "error"
                );

                return;

            }


            /* Confirm password */

            if (password !== confirm) {

                showNotification(
                    "Passwords do not match.",
                    "error"
                );

                return;

            }


            /* Terms */

            if (!terms) {

                showNotification(
                    "Please accept the terms.",
                    "error"
                );

                return;

            }


            /*
                DEMO ACCOUNT

                Store only demo information
                locally in this browser.
            */

            localStorage.setItem(
                "agroUserName",
                name
            );

            localStorage.setItem(
                "agroUserEmail",
                email
            );

            localStorage.setItem(
                "agroUserRole",
                role
            );


            showNotification(
                "Account created successfully! 🌱"
            );


            setTimeout(
                function () {

                    window.location.href =
                        "login.html";

                },
                1500
            );

        }

    </script>


</body>

</html>
