<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Smart Agro Care - Sign Up</title>

<link rel="stylesheet" href="style.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>

<body class="login-page">

<div class="overlay">

<div class="login-container">

<div class="left-side">

<h1>🌾 Smart Agro Care</h1>

<h2>Create Your Account</h2>

<p>
Join Smart Agro Care and use AI-powered farming tools for
soil analysis, crop disease detection, fertilizer recommendations,
weather forecasting, and market prices.
</p>

<div class="features">

<div class="feature">
<i class="fa-solid fa-seedling"></i>
<p>Soil Analysis</p>
</div>

<div class="feature">
<i class="fa-solid fa-leaf"></i>
<p>Disease Detection</p>
</div>

<div class="feature">
<i class="fa-solid fa-cloud-sun"></i>
<p>Weather Forecast</p>
</div>

<div class="feature">
<i class="fa-solid fa-robot"></i>
<p>AI Chatbot</p>
</div>

</div>

</div>

<div class="right-side">

<div class="login-box">

<h2>Create Account 🌱</h2>

<form>

<div class="input-box">
<i class="fa-solid fa-user"></i>
<input type="text" placeholder="Full Name" required>
</div>

<div class="input-box">
<i class="fa-solid fa-envelope"></i>
<input type="email" placeholder="Email Address" required>
</div>

<div class="input-box">
<i class="fa-solid fa-phone"></i>
<input type="tel" placeholder="Phone Number" required>
</div>

<div class="input-box">
<i class="fa-solid fa-lock"></i>
<input type="password" placeholder="Password" required>
</div>

<div class="input-box">
<i class="fa-solid fa-lock"></i>
<input type="password" placeholder="Confirm Password" required>
</div>

<div style="margin:15px 0;">
<label><b>Upload Profile Photo</b></label><br><br>
<input type="file">
</div>

<div style="margin:20px 0;">
<label>
<input type="checkbox" required>
I agree to the Terms & Conditions
</label>
</div>

<button class="login-btn">
Create Account
</button>

<p class="signup">
Already have an account?
<a href="login.html">Login</a>
</p>

</form>

</div>

</div>

</div>

</div>

</body>
</html>
