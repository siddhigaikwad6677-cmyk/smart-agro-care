<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Sign Up | Smart Agro Care</title>


    <!-- GOOGLE FONTS -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet">


    <!-- FONT AWESOME -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {

            font-family: "DM Sans", sans-serif;

            min-height: 100vh;

            background:
                linear-gradient(
                    135deg,
                    #08371e,
                    #17653b,
                    #4a9b5f
                );

            color: white;

        }


        /* =====================================
                    MAIN PAGE
        ====================================== */

        .signup-page {

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 60px 20px 30px;

            position: relative;

            overflow: hidden;

        }


        /* =====================================
                    BACKGROUND
        ====================================== */

        .circle {

            position: absolute;

            border-radius: 50%;

            background:
                rgba(255,255,255,.06);

            animation:
                floatCircle 9s ease-in-out infinite;

        }


        .circle-one {

            width: 450px;

            height: 450px;

            top: -230px;

            left: -150px;

        }


        .circle-two {

            width: 550px;

            height: 550px;

            right: -220px;

            bottom: -270px;

            animation-delay: 2s;

        }


        .circle-three {

            width: 180px;

            height: 180px;

            right: 20%;

            top: 12%;

            animation-delay: 4s;

        }


        @keyframes floatCircle {

            0%,100% {

                transform:
                    translateY(0);

            }

            50% {

                transform:
                    translateY(-20px);

            }

        }


        /* =====================================
                    FLOATING LEAVES
        ====================================== */

        .floating-leaf {

            position: absolute;

            color:
                rgba(255,255,255,.23);

            font-size: 28px;

            animation:
                leafFloat 8s linear infinite;

        }


        .floating-leaf:nth-of-type(1) {

            left: 7%;

            top: 30%;

        }


        .floating-leaf:nth-of-type(2) {

            left: 18%;

            bottom: 8%;

            animation-delay: 2s;

        }


        .floating-leaf:nth-of-type(3) {

            right: 8%;

            top: 25%;

            animation-delay: 1s;

        }


        .floating-leaf:nth-of-type(4) {

            right: 18%;

            bottom: 12%;

            animation-delay: 3s;

        }


        @keyframes leafFloat {

            0% {

                transform:
                    translateY(30px)
                    rotate(0deg);

                opacity: .1;

            }

            50% {

                opacity: .4;

            }

            100% {

                transform:
                    translateY(-90px)
                    rotate(180deg);

                opacity: 0;

            }

        }


        /* =====================================
                    BACK HOME
        ====================================== */

        .back-home {

            position: absolute;

            top: 24px;

            left: 30px;

            color:
                rgba(255,255,255,.8);

            text-decoration: none;

            font-size: 9px;

            display: flex;

            align-items: center;

            gap: 7px;

            z-index: 10;

            transition: .3s;

        }


        .back-home:hover {

            color: white;

            transform:
                translateX(-3px);

        }


        /* =====================================
                    CONTAINER
        ====================================== */

        .signup-container {

            width: min(1000px, 100%);

            display: grid;

            grid-template-columns:
                .9fr 1.1fr;

            border-radius: 30px;

            overflow: hidden;

            background:
                rgba(255,255,255,.1);

            border:
                1px solid
                rgba(255,255,255,.18);

            box-shadow:
                0 30px 80px
                rgba(0,0,0,.25);

            backdrop-filter:
                blur(20px);

            position: relative;

            z-index: 5;

        }


        /* =====================================
                    LEFT PANEL
        ====================================== */

        .signup-info {

            padding: 45px;

            display: flex;

            flex-direction: column;

            justify-content: space-between;

            background:
                linear-gradient(
                    145deg,
                    rgba(4,50,25,.72),
                    rgba(45,126,71,.35)
                );

        }


        /* =====================================
                    BRAND
        ====================================== */

        .brand {

            display: flex;

            align-items: center;

            gap: 11px;

            color: white;

            text-decoration: none;

        }


        .brand-icon {

            width: 44px;

            height: 44px;

            border-radius: 13px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                rgba(255,255,255,.13);

            font-size: 19px;

        }


        .brand-text strong {

            display: block;

            font-size: 15px;

        }


        .brand-text span {

            display: block;

            font-size: 7px;

            letter-spacing: 3px;

            color: #a8e5b6;

            margin-top: 2px;

        }


        /* =====================================
                    LEFT CONTENT
        ====================================== */

        .info-content {

            margin-top: 55px;

        }


        .info-content small {

            color: #a8e5b6;

            font-size: 9px;

            letter-spacing: 2px;

            font-weight: 800;

        }


        .info-content h1 {

            font-family:
                "Playfair Display",
                serif;

            font-size:
                clamp(35px,4vw,52px);

            line-height: 1.08;

            margin-top: 12px;

        }


        .info-content h1 span {

            color: #91e6a4;

            font-style: italic;

        }


        .info-content p {

            color: #c1d8c8;

            font-size: 10px;

            line-height: 1.8;

            max-width: 350px;

            margin-top: 15px;

        }


        /* =====================================
                    BENEFITS
        ====================================== */

        .benefits {

            display: grid;

            gap: 11px;

            margin-top: 27px;

        }


        .benefit {

            display: flex;

            align-items: center;

            gap: 10px;

            color: #d2e5d7;

            font-size: 9px;

        }


        .benefit-icon {

            width: 29px;

            height: 29px;

            border-radius: 9px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                rgba(255,255,255,.09);

            color: #89dfa0;

        }


        .info-bottom {

            color: #a9c6b1;

            font-size: 8px;

        }


        /* =====================================
                    FORM PANEL
        ====================================== */

        .signup-form {

            padding: 43px 50px;

            background:
                rgba(255,255,255,.96);

            color: #173f2b;

        }


        .form-heading {

            margin-bottom: 22px;

        }


        .form-heading small {

            color: #35a85b;

            font-size: 8px;

            letter-spacing: 2px;

            font-weight: 800;

        }


        .form-heading h2 {

            font-family:
                "Playfair Display",
                serif;

            font-size: 32px;

            color: #123b27;

            margin-top: 5px;

        }


        .form-heading p {

            color: #849088;

            font-size: 9px;

            margin-top: 5px;

        }


        /* =====================================
                    TWO COLUMN INPUT
        ====================================== */

        .two-inputs {

            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 12px;

        }


        .input-group {

            margin-bottom: 13px;

        }


        .input-group label {

            display: block;

            color: #496152;

            font-size: 8px;

            font-weight: 800;

            margin-bottom: 6px;

        }


        .input-box {

            position: relative;

        }


        .input-box > i {

            position: absolute;

            left: 12px;

            top: 50%;

            transform:
                translateY(-50%);

            color: #76a27f;

            font-size: 11px;

        }


        .input-box input {

            width: 100%;

            padding:
                12px 37px;

            border:
                1px solid #dfe7df;

            border-radius: 11px;

            background: #f8faf8;

            outline: none;

            font-family: inherit;

            font-size: 9px;

            color: #244a33;

            transition: .25s;

        }


        .input-box input:focus {

            background: white;

            border-color: #35a85b;

            box-shadow:
                0 0 0 4px
                rgba(53,168,91,.07);

        }


        .password-toggle {

            position: absolute;

            right: 10px;

            top: 50%;

            transform:
                translateY(-50%);

            border: none;

            background: transparent;

            color: #7d8b82;

            cursor: pointer;

        }


        /* =====================================
                    TERMS
        ====================================== */

        .terms {

            display: flex;

            align-items: flex-start;

            gap: 7px;

            margin: 5px 0 17px;

            color: #7b877f;

            font-size: 8px;

            line-height: 1.5;

        }


        .terms input {

            margin-top: 2px;

            accent-color: #35a85b;

        }


        .terms a {

            color: #298c4b;

            text-decoration: none;

            font-weight: 700;

        }


        /* =====================================
                    SIGNUP BUTTON
        ====================================== */

        .signup-button {

            width: 100%;

            border: none;

            border-radius: 11px;

            padding: 14px;

            background:
                linear-gradient(
                    135deg,
                    #176b3a,
                    #35a85b
                );

            color: white;

            font-family: inherit;

            font-size: 9px;

            font-weight: 800;

            cursor: pointer;

            transition: .3s;

        }


        .signup-button:hover {

            transform:
                translateY(-3px);

            box-shadow:
                0 13px 25px
                rgba(23,107,58,.2);

        }


        /* =====================================
                    MESSAGE
        ====================================== */

        #signupMessage {

            display: none;

            margin-top: 10px;

            padding: 9px;

            border-radius: 8px;

            background: #edf8ef;

            color: #278348;

            text-align: center;

            font-size: 8px;

        }


        /* =====================================
                    LOGIN LINK
        ====================================== */

        .login-text {

            text-align: center;

            color: #839087;

            font-size: 8px;

            margin-top: 17px;

        }


        .login-text a {

            color: #298c4b;

            text-decoration: none;

            font-weight: 800;

        }


        /* =====================================
                    RESPONSIVE
        ====================================== */

        @media(max-width:820px) {

            .signup-container {

                grid-template-columns: 1fr;

            }


            .signup-info {

                padding: 32px;

                min-height: 380px;

            }


            .signup-form {

                padding: 35px;

            }

        }


        @media(max-width:500px) {

            .signup-page {

                padding:
                    60px 15px 20px;

            }


            .signup-info {

                padding: 25px;

                min-height: 350px;

            }


            .signup-form {

                padding: 27px 21px;

            }


            .two-inputs {

                grid-template-columns: 1fr;

                gap: 0;

            }


            .form-heading h2 {

                font-size: 28px;

            }

        }

    </style>

</head>


<body>


<div class="signup-page">


    <!-- BACKGROUND -->

    <div class="circle circle-one"></div>

    <div class="circle circle-two"></div>

    <div class="circle circle-three"></div>


    <!-- FLOATING LEAVES -->

    <div class="floating-leaf">

        <i class="fa-solid fa-leaf"></i>

    </div>


    <div class="floating-leaf">

        <i class="fa-solid fa-seedling"></i>

    </div>


    <div class="floating-leaf">

        <i class="fa-solid fa-leaf"></i>

    </div>


    <div class="floating-leaf">

        <i class="fa-solid fa-seedling"></i>

    </div>


    <!-- BACK -->

    <a href="index.html"
       class="back-home">

        <i class="fa-solid fa-arrow-left"></i>

        Back to Home

    </a>



    <!-- =================================
                MAIN CONTAINER
    ================================== -->

    <div class="signup-container">


        <!-- =================================
                    LEFT
        ================================== -->

        <section class="signup-info">


            <!-- BRAND -->

            <a href="index.html"
               class="brand">

                <div class="brand-icon">

                    <i class="fa-solid fa-seedling"></i>

                </div>


                <div class="brand-text">

                    <strong>
                        Smart Agro
                    </strong>

                    <span>
                        CARE
                    </span>

                </div>

            </a>



            <!-- CONTENT -->

            <div class="info-content">

                <small>
                    JOIN THE COMMUNITY
                </small>


                <h1>

                    Grow smarter.<br>

                    <span>Farm better.</span>

                </h1>


                <p>

                    Create your Smart Agro Care
                    account and bring intelligent
                    digital tools to your farming journey.

                </p>


                <!-- BENEFITS -->

                <div class="benefits">


                    <div class="benefit">

                        <div class="benefit-icon">

                            <i class="fa-solid fa-flask"></i>

                        </div>

                        Soil health insights

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">

                            <i class="fa-solid fa-leaf"></i>

                        </div>

                        Crop disease assistance

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">

                            <i class="fa-solid fa-cloud-sun"></i>

                        </div>

                        Weather-based guidance

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">

                            <i class="fa-solid fa-seedling"></i>

                        </div>

                        Smart crop recommendations

                    </div>

                </div>

            </div>


            <div class="info-bottom">

                🌱 Better decisions begin with better information.

            </div>

        </section>



        <!-- =================================
                    RIGHT FORM
        ================================== -->

        <section class="signup-form">


            <div class="form-heading">

                <small>
                    CREATE ACCOUNT
                </small>


                <h2>
                    Start growing 🌱
                </h2>


                <p>
                    Fill in your details to create your account.
                </p>

            </div>



            <!-- NAME -->

            <div class="input-group">

                <label>
                    FULL NAME
                </label>


                <div class="input-box">

                    <i class="fa-solid fa-user"></i>


                    <input
                        id="fullName"
                        type="text"
                        placeholder="Enter your full name">

                </div>

            </div>



            <!-- EMAIL + PHONE -->

            <div class="two-inputs">


                <div class="input-group">

                    <label>
                        EMAIL
                    </label>


                    <div class="input-box">

                        <i class="fa-solid fa-envelope"></i>


                        <input
                            id="email"
                            type="email"
                            placeholder="Email address">

                    </div>

                </div>



                <div class="input-group">

                    <label>
                        MOBILE NUMBER
                    </label>


                    <div class="input-box">

                        <i class="fa-solid fa-phone"></i>


                        <input
                            id="phone"
                            type="tel"
                            placeholder="Mobile number">

                    </div>

                </div>

            </div>



            <!-- PASSWORD -->

            <div class="input-group">

                <label>
                    PASSWORD
                </label>


                <div class="input-box">

                    <i class="fa-solid fa-lock"></i>


                    <input
                        id="password"
                        type="password"
                        placeholder="Create password">


                    <button
                        type="button"
                        class="password-toggle"
                        onclick="togglePassword('password','eye1')">

                        <i
                            id="eye1"
                            class="fa-solid fa-eye">
                        </i>

                    </button>

                </div>

            </div>



            <!-- CONFIRM PASSWORD -->

            <div class="input-group">

                <label>
                    CONFIRM PASSWORD
                </label>


                <div class="input-box">

                    <i class="fa-solid fa-shield-halved"></i>


                    <input
                        id="confirmPassword"
                        type="password"
                        placeholder="Confirm password">


                    <button
                        type="button"
                        class="password-toggle"
                        onclick="togglePassword('confirmPassword','eye2')">

                        <i
                            id="eye2"
                            class="fa-solid fa-eye">
                        </i>

                    </button>

                </div>

            </div>



            <!-- TERMS -->

            <label class="terms">

                <input
                    id="terms"
                    type="checkbox">


                <span>

                    I agree to the
                    <a href="#">
                        Terms & Conditions
                    </a>
                    and
                    <a href="#">
                        Privacy Policy
                    </a>.

                </span>

            </label>



            <!-- BUTTON -->

            <button
                class="signup-button"
                onclick="createAccount()">

                <i class="fa-solid fa-user-plus"></i>

                &nbsp; Create My Account

            </button>


            <!-- MESSAGE -->

            <div id="signupMessage">

                Account created successfully! 🌱

            </div>



            <!-- LOGIN -->

            <div class="login-text">

                Already have an account?

                <a href="login.html">

                    Sign in

                </a>

            </div>

        </section>

    </div>

</div>



<script>


/* =====================================
        SHOW / HIDE PASSWORD
===================================== */


function togglePassword(
    inputId,
    iconId
) {


    const input =
        document.getElementById(
            inputId
        );


    const icon =
        document.getElementById(
            iconId
        );


    if (
        input.type === "password"
    ) {

        input.type = "text";

        icon.className =
            "fa-solid fa-eye-slash";

    }

    else {

        input.type = "password";

        icon.className =
            "fa-solid fa-eye";

    }

}



/* =====================================
             CREATE ACCOUNT
===================================== */


function createAccount() {


    const name =
        document.getElementById(
            "fullName"
        ).value.trim();


    const email =
        document.getElementById(
            "email"
        ).value.trim();


    const phone =
        document.getElementById(
            "phone"
        ).value.trim();


    const password =
        document.getElementById(
            "password"
        ).value;


    const confirmPassword =
        document.getElementById(
            "confirmPassword"
        ).value;


    const terms =
        document.getElementById(
            "terms"
        ).checked;



    /* REQUIRED FIELDS */

    if (
        name === "" ||
        email === "" ||
        phone === "" ||
        password === "" ||
        confirmPassword === ""
    ) {

        alert(
            "Please fill in all fields."
        );

        return;

    }



    /* EMAIL */

    if (
        !email.includes("@")
    ) {

        alert(
            "Please enter a valid email address."
        );

        return;

    }



    /* PHONE */

    if (
        phone.length < 10
    ) {

        alert(
            "Please enter a valid mobile number."
        );

        return;

    }



    /* PASSWORD */

    if (
        password.length < 6
    ) {

        alert(
            "Password should contain at least 6 characters."
        );

        return;

    }



    /* MATCH */

    if (
        password !== confirmPassword
    ) {

        alert(
            "Passwords do not match."
        );

        return;

    }



    /* TERMS */

    if (!terms) {

        alert(
            "Please accept the Terms & Conditions."
        );

        return;

    }



    /* SUCCESS */

    document.getElementById(
        "signupMessage"
    ).style.display =
        "block";


    /* DEMO ONLY */

    setTimeout(
        function() {

            window.location.href =
                "login.html";

        },
        1800
    );

}


</script>


</body>

</html>
